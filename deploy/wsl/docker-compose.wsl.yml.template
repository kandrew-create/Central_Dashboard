services:
  migrate:
    build: {target: base}
  provision-runtime:
    build: {target: base}
  api:
    build: {target: base}
  worker:
    build: {target: base}
  caddy:
    environment:
      LINKER_EXTERNAL_HTTPS_PORT: ${LINKER_HTTPS_PORT:-443}
    ports: !override
      - "127.0.0.1:${LINKER_HTTP_PORT:-80}:80"
      - "127.0.0.1:${LINKER_HTTPS_PORT:-443}:443"
    volumes: !override
      - ./wsl/Caddyfile.local:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
