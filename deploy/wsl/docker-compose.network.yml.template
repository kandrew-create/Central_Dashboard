# Explicit Network mode. Keep database/API ports private and preserve named volumes.
services:
  migrate:
    build: {target: base}
  provision-runtime:
    build: {target: base}
  api:
    build: {target: base}
  worker:
    build: {target: base}
    environment:
      LINKER_SERVER_DATA_DIR: /ai-settings
      LINKER_DOCKER_LOCAL_AI: '1'
    volumes: [ai-settings:/ai-settings]
    networks: !override [database, gateway]
  caddy:
    ports: !override
      - "${LINKER_LISTEN_ADDRESS:?Set approved host IPv4}:${LINKER_HTTPS_PORT:?Set HTTPS port}:443"
    volumes: !override
      - ./wsl/Caddyfile.network:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
volumes:
  ai-settings:
