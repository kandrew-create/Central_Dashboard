{
	admin off
	auto_https off
}

:8080 {
	basic_auth {
		{$PGADMIN_USERNAME} {$PGADMIN_LOGIN_HASH}
	}
	reverse_proxy pgadmin:80 {
		header_up -Authorization
		header_up -X_Forwarded_User
		header_up -HTTP_X_FORWARDED_USER
		header_up -Remote_User
		header_up -Remote-User
		header_up X-Forwarded-User {http.auth.user.id}
		header_up -X_Pgadmin_Webserver_Secret
		header_up X-Pgadmin-Webserver-Secret {$PGADMIN_PROXY_SECRET}
	}
}
