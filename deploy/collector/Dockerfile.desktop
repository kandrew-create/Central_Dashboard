# Local desktop only. The source reader/scheduler stays in its separate image.
FROM docker:28-cli AS docker-cli
FROM debian:trixie-slim AS desktop
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp \
    PATH=/opt/collector/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-tk python3-venv ca-certificates fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/collector \
    && useradd --uid 10001 --create-home collector \
    && touch /run/linker-collector-desktop
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
WORKDIR /app
COPY deploy/collector/requirements.lock /tmp/collector-requirements.lock
RUN pip install --no-cache-dir -r /tmp/collector-requirements.lock
# Build only from the allowlisted context staged by build_context.py.
COPY collector ./collector
COPY shared ./shared
COPY deploy/collector ./deploy/collector
COPY deploy/docker-compose.collector*.yml ./deploy/
COPY .dockerignore ./.dockerignore
USER 10001:10001
ENTRYPOINT ["python", "-m", "deploy.collector.container_gui"]
