# Local cloud development only; supply values outside version control.
# Shell environment or Compose --env-file is required; Python does not load this.
POSTGRES_PASSWORD=replace-locally
# URL-encode reserved characters in URL passwords. Host db is the Compose service.
MIGRATION_DATABASE_URL=postgresql+psycopg://scada_migrator:replace-locally@db:5432/scada_platform
INGEST_DATABASE_PASSWORD=replace-with-at-least-20-random-characters
WORKER_DATABASE_PASSWORD=replace-with-a-different-20-character-password
INGEST_DATABASE_URL=postgresql+psycopg://scada_api_login:replace-locally@db:5432/scada_platform
WORKER_DATABASE_URL=postgresql+psycopg://scada_worker_login:replace-locally@db:5432/scada_platform
SCADA_HOSTNAME=uploads.example.com
# Test container inherits the password through PGPASSWORD, never command arguments.
